{

  "expo": {
    "sdkVersion": "54.0.0",
    "name": "Rede Sentinela",
    "slug": "rede-sentinela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/RedeSentinela.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#6E7A54"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.redesentinela.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização apenas para incluí-la no SMS de alerta enviado aos seus contatos de confiança."
      }
    },
    "android": {
      "package": "com.redesentinela.app",
      "adaptiveIcon": {
        "backgroundColor": "#6E7A54"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/RedeSentinela.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização apenas para incluí-la no SMS de alerta enviado aos seus contatos de confiança."
        }
      ]
    ]
  
}}